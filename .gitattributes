# Normalize all text files to LF on commit
* text=auto eol=lf

# Explicitly mark Python and shell files
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary files — never convert
*.day binary
*.zip binary
