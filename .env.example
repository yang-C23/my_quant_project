# 复制为 .env 后按机器实况修改；.env 不进 git
# 数据根目录（仓库外，data_platform.md §1 布局）
DATA_ROOT=/home/yang/quant_data
# Windows 侧通达信安装目录（WSL 挂载路径）
TDX_HOME=/mnt/d/new_tdx
# 全历史日线基线 zip（vipdoc 只含近期数据；两源按符号并集，重叠日 vipdoc 优先）
TDX_ZIP=/mnt/d/TDX_hsjday.zip
# 旧 PG 黄金参照库（仅 scripts/validate_vs_pg.py 使用；M3 后删除本行）
QUANT_DB_DSN=host=localhost port=5432 dbname=quant_db user=quant password=quant123
# ETL 并行 worker 数（9900X 建议 20）
ETL_WORKERS=20
