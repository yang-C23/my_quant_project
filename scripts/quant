#!/usr/bin/env python3
"""Worktree-local launcher without changing shared editable installations."""

from __future__ import annotations

import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    """Execute commands with this checkout first on Python's import path."""
    candidates = [
        os.environ.get("QUANT_PYTHON"),
        str(ROOT / ".venv/bin/python"),
        str(Path.home() / "venvs/my_quant_env/bin/python"),
        shutil.which("python3"),
    ]
    interpreter = next((p for p in candidates if p and Path(p).is_file()), None)
    if interpreter is None:
        raise SystemExit("Set QUANT_PYTHON to the project Python interpreter.")
    env = os.environ.copy()
    env["PYTHONPATH"] = str(ROOT / "src")
    env["QUANT_PROJECT_ROOT"] = str(ROOT)
    env["PYTHONHASHSEED"] = "0"
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env["PYTHONNOUSERSITE"] = "1"
    args = sys.argv[1:]
    if args[:1] == ["test"]:
        command = ["-m", "pytest", "-q", "-m", "not integration", *args[1:]]
    elif args[:1] == ["lint"]:
        for command in (
            ["-m", "ruff", "check", "."],
            ["-m", "ruff", "format", "--check", "."],
            ["scripts/check_no_hardcoded_paths.py"],
            ["scripts/check_whitelist.py"],
        ):
            result = subprocess.run([interpreter, *command], env=env, cwd=ROOT)
            if result.returncode:
                return result.returncode
        return 0
    else:
        command = ["-m", "quant.cli", *args]
    return subprocess.run([interpreter, *command], env=env, cwd=ROOT).returncode


if __name__ == "__main__":
    raise SystemExit(main())
